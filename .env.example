# =========================================================
# KrishiMitra Configuration
# =========================================================

# --- Online Cloud Mode (Default: Groq) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# --- 100% Offline Mode ---
# Set OFFLINE_MODE=true to run without internet or external APIs
OFFLINE_MODE=false

# Optional: If you run Ollama locally (https://ollama.com)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2
